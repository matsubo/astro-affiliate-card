{
  "name": "astro-affiliate-card",
  "version": "0.4.1",
  "description": "Astro integration for Amazon / Rakuten / Yahoo! affiliate product cards",
  "keywords": [
    "astro",
    "astro-integration",
    "affiliate",
    "amazon",
    "rakuten",
    "yahoo"
  ],
  "license": "MIT",
  "author": "matsubo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matsubo/astro-affiliate-card.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "default": "./dist/card.js"
    },
    "./shops": {
      "types": "./dist/shops.d.ts",
      "default": "./dist/shops.js"
    },
    "./remark": {
      "types": "./dist/remark.d.ts",
      "default": "./dist/remark.js"
    },
    "./card.css": "./dist/card.css"
  },
  "bin": {
    "affiliate-card": "dist/bin/fetch.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && cp src/card.css dist/card.css",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run lint:ci && bun run typecheck && bun run test:coverage && bun run build",
    "format": "biome format --write ./src",
    "lint": "biome check --write ./src",
    "lint:ci": "biome ci ./src",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "mdast-util-directive": "^3.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "peerDependencies": {
    "astro": ">=4.0.0",
    "remark-directive": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "remark-directive": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "^1.4.0",
    "@types/mdast": "^4.0.4",
    "astro": "^7.2.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^5.9.0",
    "unified": "^11.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
